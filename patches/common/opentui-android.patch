+  // A bun android binary reports process.platform === "android", and
+  // @opentui/core only accepts "linux" | "darwin" | "win32": its native asset
+  // resolver throws `Unsupported OpenTUI Node asset target: android-arm64` and
+  // the render library never loads. A Bun.build `define` for process.platform is
+  // ignored here -- bun's own cross-target platform folding wins -- so rewrite
+  // the reads in @opentui/core's pre-bundled chunks at bundle time instead,
+  // which is the one substitution that reaches a dependency. android is bionic
+  // linux, so "linux" is the value the rest of the chunk expects.
+  const opentuiPlatformInputs = new Set<string>()
+  const opentuiPlatformPlugin: BunPlugin = {
+    name: "opentui-android-platform",
+    setup(build) {
+      build.onLoad({ filter: /@opentui[/\\]core[/\\].*\.js$/ }, async (args) => {
+        const contents = await Bun.file(args.path).text()
+        if (!contents.includes("process.platform")) return undefined
+        opentuiPlatformInputs.add(args.path)
+        return { loader: "js", contents: contents.replace(/\bprocess\.platform\b/g, '"linux"') }
+      })
+    },
+  }
+  // Android's allocator tags heap pointers in the top byte (0xb4...), which puts
+  // every malloc'd address above 2^53. @opentui/core takes native pointers as
+  // u64 and refuses any a JS number cannot hold, so the TUI dies on its first
+  // native allocation with "Pointer exceeds safe integer range". Turn tagging
+  // off from a module the entrypoint imports first, so it runs before anything
+  // allocates through OpenTUI. bionic still accepts frees of pointers it tagged
+  // earlier. -204 is M_BIONIC_SET_HEAP_TAGGING_LEVEL, 0 is
+  // M_HEAP_TAGGING_LEVEL_NONE.
+  let heapTaggingEntry = false
+  const androidHeapTaggingPlugin: BunPlugin = {
+    name: "android-heap-tagging",
+    setup(build) {
+      build.onResolve({ filter: /^opencode-android-heap-tagging$/ }, () => ({
+        path: "heap-tagging",
+        namespace: "opencode-android",
+      }))
+      build.onLoad({ filter: /^heap-tagging$/, namespace: "opencode-android" }, () => ({
+        loader: "js",
+        contents: `import { dlopen } from "bun:ffi"
+dlopen("libc.so", { mallopt: { args: ["i32", "i32"], returns: "i32" } }).symbols.mallopt(-204, 0)`,
+      }))
+      build.onLoad({ filter: /packages[/\\]cli[/\\]src[/\\]index\.ts$/ }, async (args) => {
+        heapTaggingEntry = true
+        // After the shebang, before every other import: ES modules evaluate
+        // their imports in order.
+        const source = await Bun.file(args.path).text()
+        const shebang = source.startsWith("#!") ? source.slice(0, source.indexOf("\n") + 1) : ""
+        return { loader: "ts", contents: `${shebang}import "opencode-android-heap-tagging"\n${source.slice(shebang.length)}` }
+      })
+    },
+  }
