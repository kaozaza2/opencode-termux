+  // A bun android binary reports process.platform === "android", and
+  // @opentui/core only accepts "linux" | "darwin" | "win32": its native asset
+  // resolver throws `Unsupported OpenTUI Node asset target: android-arm64` and
+  // the render library never loads. A Bun.build `define` for process.platform is
+  // ignored here -- bun's own cross-target platform folding wins -- so rewrite
+  // the reads in @opentui/core's pre-bundled chunks at bundle time instead,
+  // which is the one substitution that reaches a dependency. android is bionic
+  // linux, so "linux" is the value the rest of the chunk expects.
+  const opentuiPlatformInputs = new Set<string>()
+  const opentuiPlatformPlugin: BunPlugin = {
+    name: "opentui-android-platform",
+    setup(build) {
+      build.onLoad({ filter: /@opentui[/\\]core[/\\].*\.js$/ }, async (args) => {
+        const contents = await Bun.file(args.path).text()
+        if (!contents.includes("process.platform")) return undefined
+        opentuiPlatformInputs.add(args.path)
+        return { loader: "js", contents: contents.replace(/\bprocess\.platform\b/g, '"linux"') }
+      })
+    },
+  }
