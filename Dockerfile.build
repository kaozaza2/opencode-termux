# Local build of the Termux (bionic) opencode binary.
#
#   docker build -t opencode-termux -f Dockerfile.build .
#   docker run --rm -v "$(pwd)/out:/workspace/out" opencode-termux
#
# Bun cross-compiles the arm64 android target from this x86_64 image; nothing
# arm64 executes during the build.

FROM ubuntu:24.04

# unzip: Bun releases are .zip archives.
# file:   build.sh reports what it packaged.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      file \
      git \
      python3 \
      unzip \
    && rm -rf /var/lib/apt/lists/*

# node-gyp runs during `bun install` for native postinstall scripts and needs Node >= 22.
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY build.sh package.sh ./
COPY patches ./patches
RUN chmod +x build.sh package.sh

ENV OPENCODE_REPO=https://github.com/anomalyco/opencode.git
ENV OPENCODE_REF=dev
ENV VERSION=0.0.0-dev-local

CMD set -eu; \
    git clone --depth 1 --branch "$OPENCODE_REF" "$OPENCODE_REPO" opencode; \
    for p in patches/*.patch patches/common/*.patch; do \
      [ -e "$p" ] || continue; \
      echo "Applying $p"; \
      git -C opencode apply "../$p"; \
    done; \
    ./build.sh "$VERSION"; \
    ./package.sh aarch64 apt "$VERSION"; \
    ./package.sh aarch64 pacman "$VERSION"
